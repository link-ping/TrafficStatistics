<UserControl x:Class="TrafficStatistics.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:TrafficStatistics.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}">
    <UserControl.Resources>
        <sys:Int32 x:Key="Int1">1</sys:Int32>
        <sys:Int32 x:Key="Int3">3</sys:Int32>
        <sys:Int32 x:Key="Int7">7</sys:Int32>
        <sys:Int32 x:Key="Int14">14</sys:Int32>
        <sys:Int32 x:Key="Int30">30</sys:Int32>
        <sys:Int32 x:Key="Int90">90</sys:Int32>
        <sys:Int32 x:Key="Int180">180</sys:Int32>
        <sys:Int32 x:Key="Int365">365</sys:Int32>
        <sys:Int32 x:Key="Int9999">9999</sys:Int32>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Page Title -->
            <RowDefinition Height="*"/>      <!-- Settings Content -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{DynamicResource Settings_Title}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                
                <!-- General Settings Group -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_General}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        
                        <!-- Auto Start -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{DynamicResource Settings_AutoStart}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Settings_AutoStartDesc}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding AutoStart}" VerticalAlignment="Center"/>
                        </Grid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                        <!-- Language Selection -->
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource Settings_Language}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Settings_LanguageDesc}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" 
                                      ItemsSource="{Binding SupportedLanguages}" 
                                      SelectedValue="{Binding Language}" 
                                      SelectedValuePath="CultureCode" 
                                      DisplayMemberPath="DisplayName" 
                                      VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Storage Settings Group -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_DataStorage}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <!-- Minute Retention -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource Settings_MinuteRetention}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Settings_MinuteRetentionDesc}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedValue="{Binding MinuteDataRetentionDays}" SelectedValuePath="Tag" VerticalAlignment="Center">
                                <ComboBoxItem Content="{DynamicResource Unit_Day_1}" Tag="{StaticResource Int1}"/>
                                <ComboBoxItem Content="{DynamicResource Unit_Days_3}" Tag="{StaticResource Int3}"/>
                                <ComboBoxItem Content="{DynamicResource Unit_Days_7}" Tag="{StaticResource Int7}"/>
                                <ComboBoxItem Content="{DynamicResource Unit_Days_14}" Tag="{StaticResource Int14}"/>
                                <ComboBoxItem Content="{DynamicResource Unit_Days_30}" Tag="{StaticResource Int30}"/>
                            </ComboBox>
                        </Grid>

                        <!-- Daily Retention -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="{DynamicResource Settings_DailyRetention}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="{DynamicResource Settings_DailyRetentionDesc}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedValue="{Binding DailyDataRetentionDays}" SelectedValuePath="Tag" VerticalAlignment="Center">
                                <ComboBoxItem Content="{DynamicResource Unit_Days_30}" Tag="{StaticResource Int30}"/>
                                <ComboBoxItem Content="{DynamicResource Unit_Days_90}" Tag="{StaticResource Int90}"/>
                                <ComboBoxItem Content="{DynamicResource Unit_Days_180}" Tag="{StaticResource Int180}"/>
                                <ComboBoxItem Content="{DynamicResource Unit_Days_365}" Tag="{StaticResource Int365}"/>
                                <ComboBoxItem Content="{DynamicResource Unit_Permanent}" Tag="{StaticResource Int9999}"/>
                            </ComboBox>
                        </Grid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,8,0,16"/>

                        <!-- Maintenance Actions -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="{DynamicResource Settings_ClearHistory}" Command="{Binding PurgeDataCommand}" Style="{StaticResource HeaderButtonStyle}" Width="150" Margin="0,0,12,0"/>
                            <TextBlock Text="{DynamicResource Settings_ClearHistoryHint}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Actions Border -->
                <Grid Margin="0,8,0,24">
                    <Button Content="{DynamicResource Settings_Save}" Command="{Binding SaveSettingsCommand}" 
                            HorizontalAlignment="Right" Padding="24,10" FontWeight="SemiBold"
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- About Group -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Settings_About}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="{DynamicResource Settings_Version}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock Text="{DynamicResource Settings_AboutDesc}" 
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
