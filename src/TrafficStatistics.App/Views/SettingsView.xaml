<UserControl x:Class="TrafficStatistics.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:TrafficStatistics.App.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}">
    <UserControl.Resources>
        <sys:Int32 x:Key="Int1">1</sys:Int32>
        <sys:Int32 x:Key="Int3">3</sys:Int32>
        <sys:Int32 x:Key="Int7">7</sys:Int32>
        <sys:Int32 x:Key="Int14">14</sys:Int32>
        <sys:Int32 x:Key="Int30">30</sys:Int32>
        <sys:Int32 x:Key="Int90">90</sys:Int32>
        <sys:Int32 x:Key="Int180">180</sys:Int32>
        <sys:Int32 x:Key="Int365">365</sys:Int32>
        <sys:Int32 x:Key="Int9999">9999</sys:Int32>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Page Title -->
            <RowDefinition Height="*"/>      <!-- Settings Content -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="配置选项" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                
                <!-- General Settings Group -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="常规设置" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>
                        
                        <!-- Auto Start -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="开机自启动" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="当 Windows 启动时自动运行流量统计工具（以管理员模式）" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding AutoStart}" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Storage Settings Group -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="数据存储设置" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                        <!-- Minute Retention -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="高精细数据保留天数" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="分钟级别网络流量详情数据保留天数。保留过长会增大数据库文件大小" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedValue="{Binding MinuteDataRetentionDays}" SelectedValuePath="Tag" VerticalAlignment="Center">
                                <ComboBoxItem Content="1 天" Tag="{StaticResource Int1}"/>
                                <ComboBoxItem Content="3 天" Tag="{StaticResource Int3}"/>
                                <ComboBoxItem Content="7 天" Tag="{StaticResource Int7}"/>
                                <ComboBoxItem Content="14 天" Tag="{StaticResource Int14}"/>
                                <ComboBoxItem Content="30 天" Tag="{StaticResource Int30}"/>
                            </ComboBox>
                        </Grid>

                        <!-- Daily Retention -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="日汇总结余保留天数" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                                <TextBlock Text="按天归档的进程累计流量记录保留天数" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" SelectedValue="{Binding DailyDataRetentionDays}" SelectedValuePath="Tag" VerticalAlignment="Center">
                                <ComboBoxItem Content="30 天" Tag="{StaticResource Int30}"/>
                                <ComboBoxItem Content="90 天" Tag="{StaticResource Int90}"/>
                                <ComboBoxItem Content="180 天" Tag="{StaticResource Int180}"/>
                                <ComboBoxItem Content="365 天" Tag="{StaticResource Int365}"/>
                                <ComboBoxItem Content="永久" Tag="{StaticResource Int9999}"/>
                            </ComboBox>
                        </Grid>

                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,8,0,16"/>

                        <!-- Maintenance Actions -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="清空历史流量数据" Command="{Binding PurgeDataCommand}" Style="{StaticResource HeaderButtonStyle}" Width="150" Margin="0,0,12,0"/>
                            <TextBlock Text="* 清空所有进程的历史捕获流量信息，重置统计" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Actions Border -->
                <Grid Margin="0,8,0,24">
                    <Button Content="保存配置" Command="{Binding SaveSettingsCommand}" 
                            HorizontalAlignment="Right" Padding="24,10" FontWeight="SemiBold"
                            Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>

                <!-- About Group -->
                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="关于流量统计小工具" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <TextBlock Text="版本: v1.0.0" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                        <TextBlock Text="这是一个运行在 Windows 上的实时进程网络流量统计和历史汇总工具。该工具纯本地运行，不含任何网络上传，无需任何驱动，底层基于 ETW (Event Tracing for Windows) 技术高效捕获网络套接字传输事件。" 
                                   Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="18"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
