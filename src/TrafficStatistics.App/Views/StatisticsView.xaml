<UserControl x:Class="TrafficStatistics.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:viewmodels="clr-namespace:TrafficStatistics.App.ViewModels"
             xmlns:converters="clr-namespace:TrafficStatistics.App.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=viewmodels:StatisticsViewModel}">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Filter & Actions Header -->
            <RowDefinition Height="Auto"/>   <!-- Period Totals Cards -->
            <RowDefinition Height="200"/>    <!-- Historical Chart -->
            <RowDefinition Height="*"/>      <!-- Top Processes Table -->
        </Grid.RowDefinitions>

        <!-- Header Filters -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <WrapPanel VerticalAlignment="Center">
                <!-- Period Selector -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                    <TextBlock Text="{DynamicResource Stats_TimeDimension}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox ItemsSource="{Binding PeriodOptions}" 
                              SelectedValue="{Binding SelectedPeriodKey}" 
                              SelectedValuePath="Key" 
                              DisplayMemberPath="DisplayName"
                              MinWidth="100" Padding="6,4" 
                              Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                </StackPanel>

                <!-- Custom Range DatePickers (Visible when custom period is active) -->
                <StackPanel Orientation="Horizontal" Margin="0,0,16,0" 
                            Visibility="{Binding IsCustomPeriodActive, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{DynamicResource Stats_From}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <DatePicker SelectedDate="{Binding CustomStartDate}" Width="120" BorderBrush="{DynamicResource BorderBrush}"/>
                    
                    <TextBlock Text="{DynamicResource Stats_To}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <DatePicker SelectedDate="{Binding CustomEndDate}" Width="120" BorderBrush="{DynamicResource BorderBrush}"/>

                    <Button Content="{DynamicResource Stats_Query}" Command="{Binding LoadDataCommand}" Style="{StaticResource HeaderButtonStyle}" Margin="8,0,0,0"/>
                </StackPanel>

                <!-- Action Button -->
                <Button Content="{DynamicResource Stats_ExportCsv}" Command="{Binding ExportToCsvCommand}" Style="{StaticResource HeaderButtonStyle}" Width="90"/>
            </WrapPanel>
        </Border>

        <!-- Totals Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Upload Card -->
            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Stats_TotalPeriodSent}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TotalPeriodSent}" Foreground="{DynamicResource WarningBrush}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Total Download Card -->
            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,8,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Stats_TotalPeriodRecv}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TotalPeriodRecv}" Foreground="{DynamicResource SuccessBrush}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Total Traffic Card -->
            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Stats_TotalPeriodTraffic}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding TotalPeriodTraffic}" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Historical Trend Chart -->
        <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource Stats_ChartTitle}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="4,0,0,4"/>
                <lvc:CartesianChart Grid.Row="1" Series="{Binding TrafficChartSeries}" XAxes="{Binding XAxes}" YAxes="{Binding YAxes}" LegendPosition="Right"/>
            </Grid>
        </Border>

        <!-- Top Ranking Processes DataGrid -->
        <Border Grid.Row="3" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="{DynamicResource Stats_RankingTitle}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontWeight="SemiBold" Margin="16,12,0,8"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding TopProcesses}" 
                          AutoGenerateColumns="False" 
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          Background="Transparent"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource DataGridRowAlternateBrush}"
                          Sorting="DataGrid_Sorting">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            <Setter Property="Padding" Value="10,8"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource CardBackgroundHoverBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{DynamicResource Col_Rank}" Binding="{Binding Rank}" Width="60" SortMemberPath="Rank">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="{DynamicResource Col_Process}" Width="2*" SortMemberPath="ProcessName">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="4,0">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding ProcessName}" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="{DynamicResource Col_ProcessId}" Binding="{Binding ProcessId}" Width="80" SortMemberPath="ProcessId">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="{DynamicResource Col_Sent}" Binding="{Binding TotalSentText}" Width="120" SortMemberPath="TotalSent">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="{DynamicResource Col_Recv}" Binding="{Binding TotalRecvText}" Width="120" SortMemberPath="TotalRecv">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Header="{DynamicResource Col_TotalTraffic}" Binding="{Binding TotalTrafficText}" Width="120" SortMemberPath="TotalTraffic">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
