<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Global / Window / Sidebar -->
    <sys:String x:Key="App_Title">流量统计小工具</sys:String>
    <sys:String x:Key="App_TrayToolTip">流量统计小工具 - 双击还原</sys:String>
    <sys:String x:Key="App_TotalSpeed">当前总速率:</sys:String>
    <sys:String x:Key="App_UploadSpeed">总上传速度</sys:String>
    <sys:String x:Key="App_DownloadSpeed">总下载速度</sys:String>
    <sys:String x:Key="App_ActiveProcesses">活动进程数</sys:String>
    <sys:String x:Key="App_DarkMode">暗色模式</sys:String>
    <sys:String x:Key="App_LightMode">明色模式</sys:String>

    <!-- Navigation -->
    <sys:String x:Key="Nav_Realtime">实时监控</sys:String>
    <sys:String x:Key="Nav_Statistics">历史统计</sys:String>
    <sys:String x:Key="Nav_Settings">配置选项</sys:String>

    <!-- Realtime View -->
    <sys:String x:Key="Realtime_ChartTitle">实时速率监控 (最近 60 秒)</sys:String>
    <sys:String x:Key="Realtime_ChartUpload">上传速率</sys:String>
    <sys:String x:Key="Realtime_ChartDownload">下载速率</sys:String>
    <sys:String x:Key="Realtime_ChartSpeedAxis">速率</sys:String>
    <sys:String x:Key="Realtime_SearchPlaceholder">搜索进程名称或 PID...</sys:String>
    <sys:String x:Key="Col_ProcessName">进程名称</sys:String>
    <sys:String x:Key="Col_PID">PID</sys:String>
    <sys:String x:Key="Col_UploadSpeed">上传速度</sys:String>
    <sys:String x:Key="Col_DownloadSpeed">下载速度</sys:String>
    <sys:String x:Key="Col_TotalSent">累计发送</sys:String>
    <sys:String x:Key="Col_TotalRecv">累计接收</sys:String>

    <!-- Statistics View -->
    <sys:String x:Key="Stats_TimeDimension">统计维度:</sys:String>
    <sys:String x:Key="Stats_Period_Hour">小时</sys:String>
    <sys:String x:Key="Stats_Period_Day">日</sys:String>
    <sys:String x:Key="Stats_Period_Week">周</sys:String>
    <sys:String x:Key="Stats_Period_Month">月</sys:String>
    <sys:String x:Key="Stats_Period_Custom">自定义</sys:String>
    <sys:String x:Key="Stats_From">从:</sys:String>
    <sys:String x:Key="Stats_To">至:</sys:String>
    <sys:String x:Key="Stats_Query">查询</sys:String>
    <sys:String x:Key="Stats_ExportCsv">导出 CSV</sys:String>
    <sys:String x:Key="Stats_TotalPeriodSent">所选区间总上传</sys:String>
    <sys:String x:Key="Stats_TotalPeriodRecv">所选区间总下载</sys:String>
    <sys:String x:Key="Stats_TotalPeriodTraffic">所选区间总流量</sys:String>
    <sys:String x:Key="Stats_ChartTitle">流量变化趋势</sys:String>
    <sys:String x:Key="Stats_ChartUpload">上传流量</sys:String>
    <sys:String x:Key="Stats_ChartDownload">下载流量</sys:String>
    <sys:String x:Key="Stats_RankingTitle">进程流量消耗排行</sys:String>
    <sys:String x:Key="Col_Rank">排名</sys:String>
    <sys:String x:Key="Col_Process">进程</sys:String>
    <sys:String x:Key="Col_ProcessId">PID/标识</sys:String>
    <sys:String x:Key="Col_Sent">已上传</sys:String>
    <sys:String x:Key="Col_Recv">已下载</sys:String>
    <sys:String x:Key="Col_TotalTraffic">总计流量</sys:String>
    <sys:String x:Key="Stats_ExportSuccess">数据导出成功！</sys:String>
    <sys:String x:Key="Stats_ExportFailed">导出失败: </sys:String>
    <sys:String x:Key="Stats_CsvFileName">流量统计</sys:String>
    <sys:String x:Key="Stats_CsvHeader">排名,进程名称,可执行路径,上传流量(Bytes),下载流量(Bytes),总流量(Bytes)</sys:String>

    <!-- Settings View -->
    <sys:String x:Key="Settings_Title">配置选项</sys:String>
    <sys:String x:Key="Settings_General">常规设置</sys:String>
    <sys:String x:Key="Settings_AutoStart">开机自启动</sys:String>
    <sys:String x:Key="Settings_AutoStartDesc">当 Windows 启动时自动运行流量统计工具（以管理员模式）</sys:String>
    <sys:String x:Key="Settings_Language">界面语言</sys:String>
    <sys:String x:Key="Settings_LanguageDesc">选择应用程序界面的显示语言</sys:String>
    <sys:String x:Key="Settings_DataStorage">数据存储设置</sys:String>
    <sys:String x:Key="Settings_MinuteRetention">高精细数据保留天数</sys:String>
    <sys:String x:Key="Settings_MinuteRetentionDesc">分钟级别网络流量详情数据保留天数。保留过长会增大数据库文件大小</sys:String>
    <sys:String x:Key="Settings_DailyRetention">日汇总结余保留天数</sys:String>
    <sys:String x:Key="Settings_DailyRetentionDesc">按天归档的进程累计流量记录保留天数</sys:String>
    <sys:String x:Key="Settings_ClearHistory">清空历史流量数据</sys:String>
    <sys:String x:Key="Settings_ClearHistoryHint">* 清空所有进程的历史捕获流量信息，重置统计</sys:String>
    <sys:String x:Key="Settings_Save">保存配置</sys:String>
    <sys:String x:Key="Settings_About">关于流量统计小工具</sys:String>
    <sys:String x:Key="Settings_Version">版本: v1.0.0</sys:String>
    <sys:String x:Key="Settings_AboutDesc">这是一个运行在 Windows 上的实时进程网络流量统计和历史汇总工具。该工具纯本地运行，不含任何网络上传，无需任何驱动，底层基于 ETW (Event Tracing for Windows) 技术高效捕获网络套接字传输事件。</sys:String>

    <!-- Retention Units -->
    <sys:String x:Key="Unit_Day_1">1 天</sys:String>
    <sys:String x:Key="Unit_Days_3">3 天</sys:String>
    <sys:String x:Key="Unit_Days_7">7 天</sys:String>
    <sys:String x:Key="Unit_Days_14">14 天</sys:String>
    <sys:String x:Key="Unit_Days_30">30 天</sys:String>
    <sys:String x:Key="Unit_Days_90">90 天</sys:String>
    <sys:String x:Key="Unit_Days_180">180 天</sys:String>
    <sys:String x:Key="Unit_Days_365">365 天</sys:String>
    <sys:String x:Key="Unit_Permanent">永久</sys:String>

    <!-- Messages / Dialogs -->
    <sys:String x:Key="Msg_SaveSuccess">设置保存成功！</sys:String>
    <sys:String x:Key="Msg_SaveFailed">保存设置失败: </sys:String>
    <sys:String x:Key="Msg_PurgeConfirm">确定要清空数据库中的所有历史流量记录吗？此操作无法撤销。</sys:String>
    <sys:String x:Key="Msg_PurgeSuccess">历史数据已成功清空！</sys:String>
    <sys:String x:Key="Msg_PurgeFailed">清空数据失败: </sys:String>
    <sys:String x:Key="Msg_Prompt">提示</sys:String>
    <sys:String x:Key="Msg_Warning">警告</sys:String>
    <sys:String x:Key="Msg_Error">错误</sys:String>
    <sys:String x:Key="Msg_CaptureStartError">无法启动网络流量采集服务：{0}&#x0a;请确保以管理员权限运行此程序！</sys:String>

</ResourceDictionary>
